{
	"schemaVersion": 1,
	"id": "modguard",
	"version": "${version}",
	"name": "ModGuard",
	"description": "ModGuard allows players to browse, verify, and manage Minecraft mods directly in-game using the Modrinth API. It provides safe mod discovery, version filtering, and structured pagination without leaving Minecraft.",
	"authors": [
		"Guagyyy"
	],
	"contact": {
		"homepage": "https://github.com/Guag914",
		"sources": "https://github.com/Guag914/ModGuard",
		"issues": "https://github.com/Guag914/ModGuard/issues"
	},
	"license": "CC0-1.0",
	"icon": "assets/modguard/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"net.guag.modguard.ModGuard",
			"net.guag.modguard.modrinth.ModGuardUIClient"
		]
	},
	"mixins": [
		"modguard.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.18.4",
		"minecraft": "~1.21.11",
		"java": ">=21",
		"fabric-api": "*"
	}
}